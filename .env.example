# AQUILOOP — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.
#
# ────────────────────────────────────────────────────────
# AWS / AMPLIFY GEN 2
# ────────────────────────────────────────────────────────
# These are populated automatically by `amplify_outputs.json`
# when you run `npx ampx sandbox`. You do NOT need to set
# them manually here — Amplify reads amplify_outputs.json at runtime.
#
# Required only if you use the AWS SDK directly (outside Amplify):
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ────────────────────────────────────────────────────────
# NEXT.JS PUBLIC VARS (safe to expose client-side)
# ────────────────────────────────────────────────────────
# Set to "true" once a real Amplify sandbox/environment is deployed
# and amplify_outputs.json is present. Defaults to "false" for local dev.
NEXT_PUBLIC_AWS_ENABLED=

# ────────────────────────────────────────────────────────
# FUTURE STAGES (do not configure yet)
# ────────────────────────────────────────────────────────
# Stage 11 — Amazon Cognito
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_WEB_CLIENT_ID=

# Stage 12 — AppSync / DynamoDB
# NEXT_PUBLIC_APPSYNC_GRAPHQL_ENDPOINT=

# Stage 13 — Amazon S3 (Evidence Uploads)
# NEXT_PUBLIC_S3_EVIDENCE_BUCKET=

# Stage 15 — Amazon Bedrock (AI Risk Assessment)
# BEDROCK_MODEL_ID=

# Stage 17 — Local Demo Account Provisioning (never commit real passwords)
# Set in .env.local or pass in shell before running `npm run seed:users`
AQUILOOP_DEMO_PASSWORD=

